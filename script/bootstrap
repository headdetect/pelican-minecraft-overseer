#!/usr/bin/env bash
# Checks the tools the dev stack needs and pulls its Docker images.
# script/up runs this first. Safe to re-run: it only pulls missing images.
#
# Usage: script/bootstrap [--update]
#   --update  pull every image again, to pick up a new panel or wings release
set -euo pipefail

cd "$(dirname "$0")/.."

fail() { echo "bootstrap: $*" >&2; exit 1; }

command -v docker >/dev/null || fail "Docker is not installed. See https://docs.docker.com/engine/install/"
docker info >/dev/null 2>&1 || fail "Docker is not running, or this user cannot use it."
docker compose version >/dev/null 2>&1 || fail "The Docker Compose plugin is not installed."
command -v curl >/dev/null || fail "curl is not installed."

# script/screenshot pins its Playwright version, so read it from there.
playwright=$(sed -n 's/^PW=//p' script/screenshot)
images=(
  $(DEV_DATA="$PWD/.data" docker compose config --images)
  "mcr.microsoft.com/playwright/python:v$playwright-noble"
  alpine:3
)

for image in "${images[@]}"; do
  if [ "${1:-}" = --update ] || ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "bootstrap: pulling $image"
    docker pull -q "$image" >/dev/null
  fi
done

# The stack uses the host network, so another program on one of these ports
# breaks it. Skip the check when the dev panel is already up.
if [ -z "$(docker ps -q -f name=^overseer-dev-panel$)" ] && command -v ss >/dev/null; then
  for port in "${PANEL_PORT:-8890}" "${WINGS_PORT:-8891}" 2023 25565 25575 8100; do
    if ss -Htln "sport = :$port" | grep -q .; then
      fail "port $port is in use. Stop what is using it, or see DEVELOPMENT.md for the ports."
    fi
  done
fi

echo "bootstrap: ready"
