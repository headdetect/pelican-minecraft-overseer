#!/usr/bin/env bash
# Sends one command to the dev game server over RCON, through Overseer's own
# RconConnector, so it uses the same address and password lookup as the pages.
# Example: script/rcon list
set -euo pipefail
[ $# -gt 0 ] || { echo "usage: script/rcon <command>" >&2; exit 2; }
exec docker exec -u www-data overseer-dev-panel php /script-lib/rcon.php "$*"
